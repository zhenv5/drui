#!/usr/bin/env python3
"""DRUI: terminal entrypoint for GameAgentKit workflows and verified updates.

`drui list` exposes the menu; `drui prompt <stage>` prints a pasteable
instruction for an agent. Workflow commands never execute agent actions; `update --yes` explicitly upgrades the kit.
"""
from __future__ import annotations

import argparse
import difflib
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
from gamekit import WORKFLOW_STAGES, WORKFLOW_CATEGORIES, DRUI_UI_SOURCE_CHOICES, show_workflow_menu, show_workflow_help, show_ui_sources, main as gamekit_main  # noqa: E402


def show_welcome(*, detailed=False):
    print("DRUI — GameAgentKit: 更容易做出好用、好看的游戏 UI")
    print("20 个工作流 | 12 个内置 Skills | 支持 Codex / Claude Code / Antigravity / Cursor")
    print("\n首次使用 / 1-minute quickstart:")
    print("  1. drui list --beginner       先看 6 个适合入门的工作流")
    print("  2. drui help usability-review  了解某个流程是否适合你")
    print("  3. drui prompt review-loop    生成可复制到 Agent 对话的指令")
    print("\n不知道选哪个? / Choose by goal:")
    print("  新用户不会操作    → usability-review (只读)")
    print("  UI 不够漂亮     → visual-review    (只读)")
    print("  想要三方独立审查 → review-triad    (只读)")
    print("  审查后自动修复   → review-loop     (可以修改)")
    print("  从头到尾完整优化 → full           (可以修改)")
    print("\n关键区别: 终端 drui prompt 只打印指令，不会运行 AI Agent 或修改游戏。")
    print("在 Codex / Claude Code 等 Agent 对话里输入:")
    print("  Use the drui skill, stage review-loop, on this project.")
    if not detailed:
        print("\n更多命令: drui help commands | drui list | drui start")
        return
    print("\n使用前检查 (已有安装时):")
    print("  drui version                查看当前版本")
    print("  drui deps conflicts         检查同名 Skill 冲突")
    print("  drui deps check             检查已锁定外部 Skill 是否变更")
    print("  drui sources                查看 UI 来源与优先级")
    print("  drui list --search 操作     根据问题搜索工作流")
    print("\n未安装? 阅读 QUICKSTART.md 或 https://github.com/zhenv5/drui#readme")
    print("如果出现 drui: command not found，可执行:")
    print("  python3 ~/GameAgentKit/scripts/drui start")
    print("若不在 PATH，可手动将 ~/.local/bin 加入 PATH；安装器不会修改 shell 配置。")
    print("第三方 Skills 不会被 DRUI 自动升级或覆盖；指纹相同也不代表安全。")


def show_commands():
    print("DRUI 命令速查 / Command reference")
    print("  drui start                         首次使用 1 分钟引导")
    print("  drui help                          快速上手与场景推荐")
    print("  drui help <workflow>               适用场景、权限、交付物、示例")
    print("  drui help commands                 此命令速查")
    print("  drui list                          全部 20 个工作流及读写权限")
    print("  drui list --beginner               入门推荐 6 项")
    print("  drui list --category review        按 core/ui/specialty/review 分类")
    print("  drui list --search 操作            中英文搜索")
    print("  drui list --json                   机器可读目录")
    print("  drui prompt <workflow>             只打印 Agent 指令")
    print("  drui prompt <workflow> --project . 指定项目路径")
    print("  drui <workflow>                    prompt 快捷方式（仍不执行）")
    print("  drui plus | drui pro               指定 UI 方法生成 full Prompt")
    print("  drui version                       查看版本和更新源")
    print("  drui sources [--agent codex]       检查可用 UI 方法")
    print("  drui deps list|conflicts|lock|check|approve   外部 Skill 指纹策略")
    print("  drui update --check                检查 GitHub Release")
    print("  drui update --yes                  显式同意校验并升级 DRUI（不升级外部 Skills）")
    print("\n终端只输出 Prompt；要实际执行，请把 Prompt 发送给 Agent。")


def cli(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv:
        show_welcome()
        return 0
    if argv[0] in ("-h", "--help"):
        show_welcome()
        return 0
    if argv[0] in ("start", "quickstart", "onboard"):
        if len(argv) != 1:
            print("Usage: drui start", file=sys.stderr)
            return 2
        show_welcome(detailed=True)
        return 0
    if argv[0] in ("list", "ls"):
        p = argparse.ArgumentParser(prog="drui list", description="Browse 20 workflows by goal, category or keyword")
        p.add_argument("--json", action="store_true", help="Machine-readable workflow catalog")
        p.add_argument("--beginner", action="store_true", help="Show six starter workflows")
        p.add_argument("--category", choices=WORKFLOW_CATEGORIES, help="Filter by core, ui, specialty or review")
        p.add_argument("--search", help="Search names, English/Chinese descriptions and use cases")
        args = p.parse_args(argv[1:])
        show_workflow_menu(json_format=args.json, category=args.category, search=args.search, beginner=args.beginner)
        return 0
    if argv[0] in ("help", "show"):
        if len(argv) == 1:
            show_welcome()
            return 0
        if len(argv) != 2:
            print("Usage: drui help [workflow|commands|deps|list|prompt|update]", file=sys.stderr)
            return 2
        subject = argv[1]
        if subject in ("-h", "--help", "start", "quickstart", "onboard"):
            show_welcome(detailed=True)
        elif subject in ("commands", "all"):
            show_commands()
        elif subject in ("list", "ls"):
            print("工作流筛选: drui list --beginner | --category core|ui|specialty|review | --search 关键词 | --json")
            print("例: drui list --search 操作; drui list --category review")
        elif subject in ("deps", "dependencies"):
            print("第三方 Skills 属于用户或其上游作者，DRUI 不会静默升级、覆盖或执行它们。")
            print("建议顺序: drui deps list → drui deps conflicts → drui deps lock（审查后）")
            print("之后: drui deps check; 变更需独立审查、实际兼容测试与 evidence 后才能 approve。")
            print("规则详见 docs/EXTERNAL_SKILL_UPDATES.md；指纹检查不等于安全保证。")
        elif subject == "update":
            print("drui update --check — 仅检查最新稳定发行版")
            print("drui update --yes   — 校验发布包 SHA-256 后备份并更新托管文件，不升级外部 Skills")
            print("drui update --repo zhenv5/drui --check — 手工指定官方仓库")
        elif subject == "prompt":
            print("drui prompt <workflow> [--project /path/to/game] [--ui-source auto|pro|plus|oil-ui|drui]")
            print("此命令只输出可复制给 Codex/Claude 等 Agent 的指令；不会自己执行。")
        elif subject in WORKFLOW_STAGES:
            show_workflow_help(subject)
        else:
            close = difflib.get_close_matches(subject, list(WORKFLOW_STAGES), n=3, cutoff=0.45)
            print(f"Unknown help topic: {subject!r}." + (" Did you mean: " + ", ".join(close) + "?" if close else ""), file=sys.stderr)
            print("Run drui help or drui list --beginner", file=sys.stderr)
            return 2
        return 0

    if argv[0] in ("sources", "providers"):
        p = argparse.ArgumentParser(prog="drui sources")
        p.add_argument("--agent", default="all", help="codex, claude, antigravity, cursor, or all")
        args = p.parse_args(argv[1:])
        show_ui_sources(ROOT, agent=args.agent)
        return 0

    if argv[0] in ("plus", "pro"):
        # Terminal shortcuts print the FULL workflow prompt; they do not run an Agent.
        rest = ["full", "--ui-source", argv[0], *argv[1:]]
        argv = ["prompt", *rest]

    if argv[0] in ("update", "deps"):
        old = sys.argv[:]
        try:
            sys.argv = [str(ROOT / "gamekit.py"), argv[0], *argv[1:], "--root", str(ROOT)]
            return gamekit_main()
        finally:
            sys.argv = old

    if argv[0] in ("version", "--version"):
        from gamekit import VERSION
        from scripts.github_update import configured_repo
        print(f"DRUI / GameAgentKit v{VERSION}")
        print(f"Installed at: {ROOT}")
        print(f"GitHub source: {configured_repo(ROOT) or 'NOT CONFIGURED (use drui update --repo zhenv5/drui --check)'}")
        print("Latest release: NOT CHECKED (offline)")
        return 0

    if argv[0] == "prompt":
        rest = argv[1:]
    elif argv[0] in WORKFLOW_STAGES:
        rest = argv
    else:
        close = difflib.get_close_matches(argv[0], list(WORKFLOW_STAGES) + ["help", "list", "start", "deps", "update"], n=3, cutoff=0.5)
        print(f"Unknown DRUI command {argv[0]!r}." + (" Did you mean: " + ", ".join(close) + "?" if close else ""), file=sys.stderr)
        print("Try: drui help  |  drui list --beginner", file=sys.stderr)
        return 2

    p = argparse.ArgumentParser(prog="drui prompt", description="Print one DRUI agent prompt; does not run it")
    p.add_argument("workflow", choices=sorted(WORKFLOW_STAGES))
    p.add_argument("--project", help="Optional path to an existing game repository")
    p.add_argument("--ui-source", choices=DRUI_UI_SOURCE_CHOICES, default="auto", help="Choose Pro > Plus > Oil UI > DRUI automatically or force exact source")
    p.add_argument("--agent", default="all", help="Check source availability for one agent")
    p.add_argument("--output", help="Write the prompt to a new file")
    p.add_argument("--force", action="store_true", help="Allow overwriting output file")
    args = p.parse_args(rest)
    delegated = ["workflow", "prompt", "--stage", args.workflow, "--root", str(ROOT), "--ui-source", args.ui_source, "--agent", args.agent]
    if args.project:
        delegated.extend(["--project", args.project])
    if args.output:
        delegated.extend(["--output", args.output])
    if args.force:
        delegated.append("--force")
    old = sys.argv[:]
    try:
        sys.argv = [str(ROOT / "gamekit.py"), *delegated]
        return gamekit_main()
    finally:
        sys.argv = old


if __name__ == "__main__":
    raise SystemExit(cli())
